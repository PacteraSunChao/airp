{
  "name": "@airp/validate",
  "version": "1.1.2",
  "author": "毛松 <maosong-life@outlook.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts",
      "node": "./src/node/index.ts"
    },
    "./diagnostic-codes": "./src/diagnostic-codes.ts",
    "./registry": "./src/registry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm dlx ultracite@7.4.2 check",
    "fix": "pnpm typecheck && pnpm dlx ultracite@7.4.2 fix"
  },
  "dependencies": {
    "@airp/diagnostics": "workspace:*",
    "@airp/protocol": "workspace:*",
    "@airp/utils": "workspace:*",
    "jsdom": "^26.1.0",
    "mermaid": "11.12.0"
  },
  "devDependencies": {
    "@airp/test-kit": "workspace:*",
    "@airp/typescript-config": "workspace:*",
    "@types/jsdom": "^21.1.7",
    "vitest": "4.1.11"
  }
}
