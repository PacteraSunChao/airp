  "blocks": [
    {
      "type": "lead",
      "text": "在 **Cursor** 渲染视图用自建找条搜**当前可见**正文；**VS Code** 继续用宿主 `enableFindWidget`。不改 `.agents`，不提 PR。",
      "@id": "nx6gv7vrng"
    },
    {
      "type": "section",
      "title": "最终形态",
      "lead": "结论先于细节。",
      "@id": "apg8alyhmi",
      "children": [
        {
          "type": "keyValueList",
          "layout": "stacked",
          "items": [
            {
              "key": "问题",
              "value": "Cursor 缺少 `WebFrameMain.findInFrame`；`enableFindWidget` 能出栏但搜不到。VS Code 原生 Find 正常。",
              "@id": "xezs3frg7u"
            },
            {
              "key": "范围",
              "value": "仅 `apps/renderer-vscode`；仅 Cursor 启用自建查找",
              "@id": "hjxqa1f43r"
            },
            {
              "key": "宿主",
              "value": "`vscode.env.appName` 大小写不敏感包含 `cursor` → `enableFindWidget: false`；否则 `true`",
              "@id": "ohxqk9d7nv"
            },
            {
              "key": "传参",
              "value": "拼 HTML 时写入宿主标记 `data-airp-use-custom-find`（`true`/`false`）；不新增 message 类型",
              "@id": "8uan7xkge3"
            },
            {
              "key": "webview",
              "value": "标记为 true 时拦截 ⌘F/Ctrl+F；可见文本匹配；`Range.getClientRects()` overlay 描框高亮（不改正文 DOM）",
              "@id": "efp8caol5w"
            },
            {
              "key": "落点",
              "value": "宿主检测小模块；`host-injected-css` 找条与 overlay 样式；`src/webview/find-bar.ts` + `reader-bridge` 挂载",
              "@id": "dw9aex7a4w"
            }
          ],
          "@id": "w11gz2usr3"
        },
        {
          "type": "decision",
          "title": "是否拆阶段 0",
          "chosen": "不设阶段 0",
          "rationale": "无 `.agents` / 术语表变更；规范改动才需要阶段 0。",
          "status": "accepted",
          "@id": "vwhva4rol3"
        },
        {
          "type": "decision",
          "title": "阶段粒度",
          "chosen": "单实施阶段一次落地",
          "rationale": "宿主开关与找条必须同批交付；拆开会留下半成品。",
          "status": "accepted",
          "@id": "ncizg1rd3k"
        },
        {
          "type": "decision",
          "title": "如何把 useCustomFind 交给页面",
          "chosen": "HTML `data-airp-use-custom-find`",
          "rationale": "会话内不变；与 toast-copy 宿主标记同模式；无需扩展 `HostToWebviewMessage`。",
          "status": "accepted",
          "@id": "aboktuy0hz"
        },
        {
          "type": "decision",
          "title": "搜索与高亮",
          "chosen": "可见文本 Range + fixed overlay 描框",
          "rationale": "输入框保持焦点时 Selection/`window.find` 无法保留高亮；`::highlight`/`mark` 或不能画外框或改正文。overlay 不改正文、可画边框，滚动/缩放时重绘。",
          "status": "accepted",
          "@id": "frqljntyxy"
        },
        {
          "type": "decision",
          "title": "找条视觉",
          "chosen": "右上固定找条 + overlay 命中框",
          "rationale": "找条浮层 token 对齐菜单/toast；命中用 `[data-airp-find-hit]`（当前项 `data-current`）仅描框、无填充底；z-index：export 70 < overlay 75 < 找条 80 < toast 100。",
          "status": "accepted",
          "@id": "bxqkcsdokp"
        }
      ]
    },
