          ],
          "@id": "w4ml9m2icq"
        },
        {
          "type": "keyValueList",
          "layout": "stacked",
          "items": [
            {
              "key": "找条布局",
              "value": "`position: fixed` 右上；`[输入] n/m ↑ ↓ ✕`；z-index 80（overlay 75）",
              "@id": "r03cm0zlxp"
            },
            {
              "key": "材质",
              "value": "`var(--bg-surface)`、`var(--border-color)`、`border-radius: 0.75rem`、`box-shadow: var(--shadow-float)`；字号与 export/toast 同档",
              "@id": "xse38r2zss"
            },
            {
              "key": "动效",
              "value": "可省略；若有则仅 160ms opacity，不做菜单式 scale 展开",
              "@id": "czvv9ol61g"
            },
            {
              "key": "检测 API",
              "value": "`vscode.env.appName.toLowerCase().includes(\"cursor\")`；webview 内不猜 UA",
              "@id": "x8amh0xkt2"
            }
          ],
          "@id": "el2wkaau9o"
        }
      ]
    },
    {
      "type": "section",
      "title": "不做",
      "@id": "d9oda1tedj",
      "children": [
        {
          "type": "constraint",
          "rule": "不搜隐藏 tab、折叠隐藏块；不自动切换 tab。",
          "scope": "搜索范围",
          "nonNegotiable": true,
          "@id": "828dbf9zgy"
        },
        {
          "type": "constraint",
          "rule": "不做正则、整词、大小写敏感等高级选项。",
          "scope": "找条能力",
          "nonNegotiable": true,
          "@id": "mgnq7at4vg"
        },
        {
          "type": "constraint",
          "rule": "不在 VS Code 关闭原生 Find，不强制两边统一自建。",
          "scope": "宿主策略",
          "nonNegotiable": true,
          "@id": "av62iofvq1"
        },
        {
          "type": "constraint",
          "rule": "匹配高亮只用 `Range.getClientRects()` overlay 描框；不用 `window.find` Selection、CSS Highlight、或正文 `<mark>`。",
          "scope": "匹配绘制",
          "nonNegotiable": true,
          "@id": "3pm1jtoghd"
        },
        {
          "type": "constraint",
          "rule": "不另造阴影/主题色；复用 `--shadow-float` 等阅读器浮层 token。",
          "scope": "视觉",
          "nonNegotiable": true,
          "@id": "edrbag8gaj"
        },
        {
          "type": "constraint",
          "rule": "不新增 `HostToWebviewMessage` 传递查找开关。",
          "scope": "协议",
          "nonNegotiable": true,
          "@id": "ktkir6gy7d"
        },
        {
          "type": "constraint",
          "rule": "不改 `.agents`、术语表或其它包（范围外只记、不顺手改）。",
          "scope": "仓库边界",
          "nonNegotiable": true,
          "@id": "tdnfin8pgc"
        }
      ]
    },
