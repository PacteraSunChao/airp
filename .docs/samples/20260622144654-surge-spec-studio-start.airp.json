        {
          "type": "decision",
          "id": "dec-single-file",
          "title": {
            "zh-CN": "单文件 vs basic/detailed 分文件"
          },
          "status": "accepted",
          "context": {
            "zh-CN": "DDD 聚合以 Screen 为界；同一 Component 在基本/详细间强关联，分文件增加 Ref 解析成本。"
          },
          "chosen": {
            "zh-CN": "单 `.ssp.json` + 属性级 designPhase + validate 规则"
          },
          "rationale": {
            "zh-CN": "与 Markdown 三件套合并为单 SSOT 一致；Skill 按切片编辑不同对象子树，而非分文件。"
          }
        },
        {
          "type": "openQuestion",
          "question": {
            "zh-CN": "Component ID 策略：screenLayout 行号 vs 语义 slug（如 deposit-amount-super-under-3m）？需用預入内容設定样本验证 No 重号问题。"
          },
          "blocking": true
        },
        {
          "type": "openQuestion",
          "question": {
            "zh-CN": "catalog 作用域：项目级 vs 组织级？共通组件是否跨项目共享？"
          },
          "blocking": false
        },
        {
          "type": "risk",
          "id": "risk-object-granularity",
          "title": {
            "zh-CN": "对象粒度膨胀"
          },
          "severity": "medium",
          "likelihood": "likely",
          "description": {
            "zh-CN": "约 40 个对象可能导致 Schema 复杂度过高、AI 生成时遗漏关联。"
          },
          "mitigation": {
            "zh-CN": "优先冻结 Ref + UI 树 + Event 三棵核心树；其余对象按需增量加入 Schema。"
          },
          "status": "open"
        },
        {
          "type": "assumption",
          "statement": {
            "zh-CN": "一画面一 `.ssp.json`；功能群通过 `meta.featureGroup`（LocaleRef）关联；项目级 messages 可外置 merge。"
          },
          "validated": false
        }
