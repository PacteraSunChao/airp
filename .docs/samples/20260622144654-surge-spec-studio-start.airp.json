            "diagramKind": "flowchart",
            "source": "flowchart TB\n  subgraph input [\"Projection Inputs\"]\n    xlsx[\"Excel import\"]\n    mdIn[\"Markdown import\"]\n    manual[\"Manual / AI edit\"]\n  end\n  subgraph core [\"SPECP Core\"]\n    catalog[\"catalog 仓库\"]\n    spec[\"spec 画面聚合\"]\n    ref[\"Ref 引用系统\"]\n  end\n  subgraph output [\"Projection Outputs\"]\n    xlsxOut[\"Excel export\"]\n    mdOut[\"Markdown export\"]\n    htmlOut[\"HTML\"]\n    testOut[\"TestCase\"]\n  end\n  input --> core\n  catalog --> spec\n  ref --> spec\n  core --> output"
          },
          "modules": [
            {
              "title": {
                "zh-CN": "i18n.messages"
