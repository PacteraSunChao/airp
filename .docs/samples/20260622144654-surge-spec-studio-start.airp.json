          },
          "before": [
            {
              "type": "code",
              "language": "json",
              "filename": "anti-pattern/inline-literals.json",
              "code": "{\n  \"meta\": { \"project\": \"中国銀行\" },\n  \"spec\": {\n    \"screen\": {\n      \"title\": { \"ja\": \"預入内容設定\", \"zh-CN\": \"存入内容设定\" },\n      \"components\": [\n        { \"label\": { \"ja\": \"預入金額\" }, \"placeholder\": { \"ja\": \"例）100,000\" } }\n      ]\n    }\n  }\n}"
            }
          ],
          "after": [
            {
              "type": "code",
              "language": "json",
              "filename": "recommended/locale-pack.json",
              "code": "{\n  \"meta\": { \"project\": { \"kind\": \"locale\", \"key\": \"meta.project\" } },\n  \"i18n\": {\n    \"defaultLocale\": \"ja\",\n    \"locales\": [\"ja\", \"zh-CN\"],\n    \"messages\": {\n      \"meta.project\": { \"ja\": \"中国銀行\", \"zh-CN\": \"中国银行\" },\n      \"screen.deposit-content-setting.title\": { \"ja\": \"預入内容設定\", \"zh-CN\": \"存入内容设定\" },\n      \"field.deposit-amount.label\": { \"ja\": \"預入金額\" },\n      \"field.deposit-amount.placeholder\": { \"ja\": \"例）100,000\" }\n    }\n  },\n  \"spec\": {\n    \"screen\": {\n      \"title\": { \"kind\": \"locale\", \"key\": \"screen.deposit-content-setting.title\" },\n      \"components\": [\n        {\n          \"label\": { \"kind\": \"locale\", \"key\": \"field.deposit-amount.label\" },\n          \"placeholder\": { \"kind\": \"locale\", \"key\": \"field.deposit-amount.placeholder\" }\n        }\n      ]\n    }\n  }\n}"
            }
          ]
