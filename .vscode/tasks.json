{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-airp-renderer-target-html",
      "type": "shell",
      "command": "pnpm --filter @airp/renderer-target-html build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "build-airp-renderer-vscode",
      "dependsOn": ["build-airp-renderer-target-html"],
